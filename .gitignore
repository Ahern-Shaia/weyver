# macOS
.DS_Store

# 生成物|PDF 由 docs/pdf/build.sh 從 .md 重生(對外分享才手動 run),不入版控
docs/pdf/*.pdf

# 編輯器 / 工具
.vscode/
.idea/
*.swp

# Node / monorepo 建置產物
node_modules/
.pnpm-store/
.turbo/
dist/
*.tsbuildinfo

# Next.js
.next/
next-env.d.ts
apps/*/.next/

# Storybook
storybook-static/

# 測試 / 覆蓋率
coverage/
playwright-report/
test-results/

# 環境變數(只留 .env.example)
.env
.env.local
.env.*.local

# Playwright MCP 探索產物(不入版控)
.playwright-mcp/

# shadcn MCP 設定(本機用,不入版控)
.mcp.json

# 開發過程暫存物(截圖 / log;正式資產都在 docs/ 底下不受影響)
/*.png
/*.jpg
*.log

# F-5 local 儲存驅動根目錄(webroot 外;不進版控)
.weyver-storage/
