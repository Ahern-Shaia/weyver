{
  "name": "@weyver/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    "./styles.css": "./src/styles/tokens.css",
    "./lib/*": "./src/lib/*.ts",
    "./*": "./src/components/*.tsx"
  },
  "scripts": {
    "lint": "biome lint src",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
