    "clean": "rm -rf .turbo storybook-static node_modules/.cache"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "tailwind-merge": "^2.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.2",
    "@storybook/react": "10.5.2",
    "@storybook/react-vite": "10.5.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@weyver/config": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "10.5.2",
    "typescript": "^5.7.3",
    "vite": "^8.0.0"
  }
