# 形狀範本(只留變數名與說明,不得填真值);實際值 dev 放 .env、prod 由 Infisical 注入。
# 權威定義在 src/config/env.ts —— 此檔僅為「該設哪些」的提示。

# --- DB 兩車道 ---
# 特權車道:migration + DDL。
DATABASE_URL=postgres://weyver:weyver_dev@127.0.0.1:5433/weyver

# 🔴 app 車道:記錄 DML。**必須是無 BYPASSRLS 的非 superuser**,否則 RLS 完全不執法
#    —— 租戶隔離與記錄範圍(E-1)會靜默失效:查詢照常回資料,只是回了不該回的。
#    prod 未設或與 DATABASE_URL 相同 → 開機即拒(env.ts);dev 未設會回落特權連線並於啟動時警告。
# dev 一次性建立:
#   CREATE ROLE dev_app LOGIN PASSWORD 'dev_app' NOSUPERUSER NOBYPASSRLS IN ROLE weyver_app;
APP_DATABASE_URL=postgres://dev_app:dev_app@127.0.0.1:5433/weyver

# --- 執行環境 ---
PORT=3001
NODE_ENV=development
# prod 必須顯式設 "1"(NODE_ENV 有預設值,漏設會讓認證強制靜默失效)
WEYVER_ENFORCE_PROD_SECURITY=
# dev 設 "1" 可在非 prod 也走真實 session 認證(測 auth-gate 用)
ENFORCE_AUTH=0

# --- 認證 ---
# prod 必填(≥32 字,Infisical 注入);dev 留空則回退明示的 dev-only 佔位值
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# ⚠️ 必須含**前端實際跑的 port**。不含就整條註冊/登入被擋在 403 Invalid origin,
# 而畫面只顯示「Invalid origin」—— 從症狀看不出是 env 沒對齊(:3000 常被別的專案佔用)。
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- 檔案儲存 ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.weyver-storage
# STORAGE_DRIVER=s3 時必填
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_MAX_FILE_MB=20
STORAGE_TENANT_QUOTA_MB=2048
