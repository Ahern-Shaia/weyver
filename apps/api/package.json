{
  "name": "@weyver/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "biome lint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:migrate:auth": "tsx src/auth/migrate-auth.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "^2.0.2",
    "@weyver/formula": "workspace:*",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.38.3",
    "fastify": "4.28.1",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@weyver/config": "workspace:*",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.0"
  }
}
